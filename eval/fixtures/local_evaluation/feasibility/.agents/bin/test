#!/usr/bin/env -S -u RUBYLIB -u BUNDLE_GEMFILE -u BUNDLE_LOCKFILE -u BUNDLE_BIN_PATH -u BUNDLE_PATH -u BUNDLE_APP_CONFIG -u BUNDLER_SETUP ruby --disable=rubyopt
root = File.expand_path('../..', __dir__)
ENV['BUNDLE_GEMFILE'] = File.join(root, 'Gemfile')
require 'bundler/setup'
Dir.chdir(root)
tests = ARGV.empty? ? Dir.glob('test/**/*_test.rb').sort : ARGV
abort 'No fixture tests found.' if tests.empty?
tests.each { |path| require File.expand_path(path) }
