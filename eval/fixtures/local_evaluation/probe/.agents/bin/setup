#!/usr/bin/env -S -u RUBYLIB -u BUNDLE_GEMFILE -u BUNDLE_LOCKFILE -u BUNDLE_BIN_PATH -u BUNDLE_PATH -u BUNDLE_APP_CONFIG -u BUNDLER_SETUP ruby --disable=rubyopt
require 'rbconfig'
Dir.chdir(root = File.expand_path('../..', __dir__))
ENV.delete('RUBYOPT')
ENV['BUNDLE_GEMFILE'] = File.join(root, 'Gemfile')
ENV['BUNDLE_FROZEN'] = 'true'
exec RbConfig.ruby, '-S', 'bundle', 'install', *ARGV
