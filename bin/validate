#!/usr/bin/env ruby
# frozen_string_literal: true

Dir.chdir(File.expand_path('..', __dir__)) do
  tests = 'Dir.glob("test/**/*_test.rb").sort.each { |path| require_relative path }'
  abort 'Tests failed' unless system('bundle', 'exec', 'ruby', '-Itest', '-e', tests)
  exit(system('bundle', 'exec', 'rubocop') ? 0 : 1)
end
